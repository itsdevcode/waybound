# Database Connection (Async PostgreSQL)
# Render format (postgres:// or postgresql://) is automatically converted to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://waybound_user:waybound_password@localhost:5432/waybound
# Conservative connection pool defaults suited for small Render instances (e.g. Free/Starter tiers)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
WEB_CONCURRENCY=1

# CORS Allowed Origins
# Development: * or http://localhost:3000
# Production: strictly required explicit HTTPS allowlist (e.g. https://waybound-frontend.onrender.com)
CORS_ORIGINS=*

# Trusted Proxy Boundaries (comma-separated IPs/CIDRs for reverse proxy header evaluation)
# Example for Render internal network: 127.0.0.1,::1,10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1

# Quest Engine Provider Mode: "demo" (default) or "google_places_gemma"
QUEST_PROVIDER=demo

# Google Places API (New) Configuration
# API key must have Places API (New) enabled in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_SEARCH_RADIUS_METERS=5000.0
GOOGLE_PLACES_MIN_RADIUS_METERS=100.0
GOOGLE_PLACES_MAX_RADIUS_METERS=50000.0
GOOGLE_PLACES_TIMEOUT_SECONDS=10.0

# Gemma AI Game Master Configuration
# Compatible with Google Generative Language API or OpenAI/vLLM/Ollama compatible endpoints
GEMMA_API_KEY=your_gemma_or_google_ai_key_here
GEMMA_MODEL=gemma-2-9b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=30.0
GEMMA_MAX_RETRIES=3

# Real-world Verification Safety Note:
# Real-world AI-generated quests (google_places_gemma) currently use provisional observation verification.
# To prevent progression exploitation from unverified AI hypotheses, real-world AI quests award exactly 0 XP
# until field-verified observation ground truth is implemented. Simulated demo quests continue to award XP.

# Geofence Proximity Radius for Arrival Verification (meters)
VERIFICATION_RADIUS_METERS=100.0

# Phase 4B: Social Mystery Partner & Proof-of-Identity Session Authentication
# Environment: "development" or "production"
ENVIRONMENT=development
# Set to false in production to disable unverified demo sessions entirely
ALLOW_DEMO_AUTH=true
# Secret key used for signing / server-side verification of session tokens and salted OTPs.
# CRITICAL: In production, this must be a cryptographically random string with at least 32 characters.
AUTH_SECRET=dev_secret_waybound_session_key_change_in_production
SESSION_TOKEN_EXPIRE_DAYS=7
PARTY_INVITE_EXPIRE_HOURS=24
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_PER_MINUTE=10

# Multi-worker Rate Limiter Storage: "database" (recommended for multi-instance deployments) or "memory"
RATE_LIMIT_STORAGE=database

# Transactional Email Provider for Login OTPs
# Options: "simulated" (development/test only), "resend", or "smtp"
# In production, "simulated" is strictly forbidden and requires real credentials.
EMAIL_PROVIDER=simulated
# In production: must be a verified domain (e.g. "WAYBOUND <auth@yourdomain.com>")
# or Resend test sandbox "WAYBOUND <onboarding@resend.dev>". Placeholders like "waybound.dev" are rejected.
EMAIL_FROM="WAYBOUND <onboarding@resend.dev>"

# Resend Configuration (Required if EMAIL_PROVIDER=resend)
# Server-side only; never expose to frontend or client responses
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Configuration (Required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=true

# ElevenLabs Text-to-Speech Integration (Premium Voice Game Master)
# Server-side only; never expose ELEVENLABS_API_KEY to client or frontend
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENABLED=false
ELEVENLABS_TIMEOUT_SECONDS=15.0
ELEVENLABS_RATE_LIMIT_PER_MINUTE=20
NARRATION_CACHE_MAX_ITEMS=500